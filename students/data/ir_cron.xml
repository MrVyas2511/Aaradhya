<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Schedule backup task at midnight every day -->
        <record id="ir_cron_backup_database" model="ir.cron">
            <field name="name">Backup Database</field>
            <field name="model_id" ref="model_backup_scheduler"/>
            <field name="state">code</field>
            <field name="code">model._cron_backup_database()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
